# Embedding provider (MVP default: local SentenceTransformers)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider (MVP default: Google Gemini free tier)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest

# Retrieval / chunking defaults
TOP_K=5
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=90

# PDF limits (development defaults; configurable)
MAX_PDF_SIZE_MB=5
MAX_PDF_PAGES=50

# API credentials — set your real keys in a local .env (never commit)
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here
